---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import { defaultLocale, getDictionary, isLocale } from "../../i18n";
import CloseIcon from "../icons/CloseIcon.astro";

type GalleryImage = {
	src: ImageMetadata;
	alt: string;
};

interface Props {
	images: GalleryImage[];
	note?: string;
}

const { images, note } = Astro.props;
// MDX passes no page props to its components, so the locale comes from the route (i18n in astro.config).
const locale = isLocale(Astro.currentLocale)
	? Astro.currentLocale
	: defaultLocale;
const dictionary = getDictionary(locale);
const fullSizeImages = await Promise.all(
	images.map(({ src }) => getImage({ src, format: "webp" })),
);
// Thumbnail sizes follow the layout: two columns on mobile; from md three columns, or four when
// there are exactly four images so none is left alone on a row; all in max-w-7xl minus px-6 and
// gap-6 (≤ 395 px, or ≤ 290 px in four columns). Each thumbnail links to the full-size image, so it still opens without JS.
// In the lightbox the images sit side by side in a scroll-snap track: swiping works on touch
// screens without extra code, and the buttons and arrow keys only scroll the track.
const hasFourColumns = images.length === 4;
const thumbnailSizes = hasFourColumns
	? "(min-width: 1280px) 290px, (min-width: 768px) calc(25vw - 30px), calc(50vw - 36px)"
	: "(min-width: 1280px) 395px, (min-width: 768px) calc(33.33vw - 32px), calc(50vw - 36px)";
const controlClasses =
	"flex size-12 items-center justify-center text-foreground hover:text-accent focus-visible:outline-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-30 motion-safe:transition-[color,opacity]";
---

<div data-gallery class="pt-8">
	<ul
		class:list={[
			"grid grid-cols-2 gap-6",
			hasFourColumns ? "md:grid-cols-4" : "md:grid-cols-3",
		]}
	>
		{images.map((image, index) => (
			<li>
				<a
					href={fullSizeImages[index]?.src}
					data-gallery-item
					class="block border border-line bg-surface hover:border-accent focus-visible:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-colors"
				>
					<Image
						src={image.src}
						alt={image.alt}
						widths={[400, 800]}
						sizes={thumbnailSizes}
						class="aspect-[4/3] w-full object-contain"
					/>
				</a>
			</li>
		))}
	</ul>
	{note && <p class="mt-4 text-sm text-muted">{note}</p>}

	<dialog
		data-gallery-dialog
		tabindex="-1"
		aria-label={dictionary.gallery.label}
		class="fixed inset-0 m-0 outline-none h-dvh max-h-none w-full max-w-none flex-col border-0 bg-background p-0 text-foreground open:flex"
	>
		<div class="flex justify-end p-3">
			<button
				type="button"
				data-gallery-close
				aria-label={dictionary.gallery.close}
				class={controlClasses}
			>
				<CloseIcon size="1.5rem" />
			</button>
		</div>
		<ul
			data-gallery-track
			class="flex min-h-0 flex-1 snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] motion-safe:scroll-smooth"
		>
			{images.map((image, index) => (
				<li class="flex w-full shrink-0 snap-center snap-always px-14 md:px-20">
					<figure class="flex min-h-0 w-full flex-col items-center gap-4">
						{/* The image box must match the visible image, otherwise a click on the
						    letterboxing would count as a click on the image and not close the dialog. */}
						<div class="flex min-h-0 w-full flex-1 items-center justify-center">
							<img
								src={fullSizeImages[index]?.src}
								alt=""
								loading="lazy"
								decoding="async"
								class="max-h-full max-w-full"
							/>
						</div>
						<figcaption class="text-center text-sm">
							{image.alt}
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
		<p
			data-gallery-counter
			aria-live="polite"
			class="py-4 text-center text-sm text-muted"
		></p>
		<button
			type="button"
			data-gallery-previous
			aria-label={dictionary.gallery.previous}
			class:list={[
				controlClasses,
				"absolute top-1/2 left-1 -translate-y-1/2",
			]}
		>
			<span aria-hidden="true" class="text-4xl">
				‹
			</span>
		</button>
		<button
			type="button"
			data-gallery-next
			aria-label={dictionary.gallery.next}
			class:list={[
				controlClasses,
				"absolute top-1/2 right-1 -translate-y-1/2",
			]}
		>
			<span aria-hidden="true" class="text-4xl">
				›
			</span>
		</button>
	</dialog>
</div>

<style>
	/* Same open/close pattern as the mobile menu in Header.astro: fade the dialog,
	   and let the track settle from a slightly smaller scale. */
	/* Covers the strip below the h-dvh dialog under Safari's floating toolbar, see Header.astro. */
	dialog[data-gallery-dialog]::backdrop {
		background-color: var(--theme-background);
	}

	dialog[data-gallery-dialog],
	dialog[data-gallery-dialog]::backdrop {
		opacity: 0;
	}

	dialog[data-gallery-dialog] [data-gallery-track] {
		scale: 0.96;
	}

	dialog[data-gallery-dialog][open],
	dialog[data-gallery-dialog][open]::backdrop {
		opacity: 1;
	}

	dialog[data-gallery-dialog][open] [data-gallery-track] {
		scale: 1;
	}

	@starting-style {
		dialog[data-gallery-dialog][open],
		dialog[data-gallery-dialog][open]::backdrop {
			opacity: 0;
		}
		dialog[data-gallery-dialog][open] [data-gallery-track] {
			scale: 0.96;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* display + overlay (allow-discrete) keep the dialog visible until the close transition ends */
		dialog[data-gallery-dialog],
		dialog[data-gallery-dialog]::backdrop {
			transition-property: opacity, display, overlay;
			transition-behavior: allow-discrete;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
		dialog[data-gallery-dialog] [data-gallery-track] {
			transition-property: scale;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
	}
</style>

<script>
	for (const gallery of document.querySelectorAll("[data-gallery]")) {
		const dialog = gallery.querySelector<HTMLDialogElement>(
			"[data-gallery-dialog]",
		);
		const track = gallery.querySelector<HTMLElement>(
			"[data-gallery-track]",
		);
		const counter = gallery.querySelector("[data-gallery-counter]");
		const closeButton = gallery.querySelector("[data-gallery-close]");
		const previousButton = gallery.querySelector<HTMLButtonElement>(
			"[data-gallery-previous]",
		);
		const nextButton = gallery.querySelector<HTMLButtonElement>(
			"[data-gallery-next]",
		);
		const items = [
			...gallery.querySelectorAll<HTMLAnchorElement>(
				"[data-gallery-item]",
			),
		];

		if (
			!dialog ||
			!track ||
			!counter ||
			!closeButton ||
			!previousButton ||
			!nextButton
		) {
			throw new Error("Gallery elements not found");
		}

		const lastIndex = items.length - 1;

		// Every slide is as wide as the track, so the scroll position says which one is in view.
		const getCurrentIndex = (): number =>
			track.clientWidth === 0
				? 0
				: Math.round(track.scrollLeft / track.clientWidth);

		// A focused button that gets disabled drops focus out of the dialog (and the arrow keys
		// with it), so the focus moves to the opposite button first.
		const setDisabled = (
			button: HTMLButtonElement,
			disabled: boolean,
			fallback: HTMLButtonElement,
		): void => {
			if (disabled && document.activeElement === button) {
				fallback.focus();
			}
			button.disabled = disabled;
		};

		const updateControls = (): void => {
			const currentIndex = getCurrentIndex();
			counter.textContent = `${currentIndex + 1} / ${items.length}`;
			setDisabled(previousButton, currentIndex === 0, nextButton);
			setDisabled(nextButton, currentIndex === lastIndex, previousButton);
		};

		const scrollToImage = (
			index: number,
			behavior: ScrollBehavior,
		): void => {
			const clampedIndex = Math.min(Math.max(index, 0), lastIndex);
			track.scrollTo({
				left: clampedIndex * track.clientWidth,
				behavior,
			});
		};

		const hasSeveralImages = items.length > 1;
		previousButton.hidden = !hasSeveralImages;
		nextButton.hidden = !hasSeveralImages;

		items.forEach((item, index) => {
			item.addEventListener("click", (event) => {
				event.preventDefault();
				dialog.showModal();
				// Same Safari focus ring as in the mobile menu (Header.astro), here on the close button.
				dialog.focus();
				// The track has no width until the dialog is shown, so it can only jump to the image now.
				scrollToImage(index, "instant");
				updateControls();
			});
		});

		track.addEventListener("scroll", updateControls, { passive: true });

		// "auto" follows the track's scroll-behavior, which is smooth only without reduced motion.
		previousButton.addEventListener("click", () => {
			scrollToImage(getCurrentIndex() - 1, "auto");
		});
		nextButton.addEventListener("click", () => {
			scrollToImage(getCurrentIndex() + 1, "auto");
		});
		closeButton.addEventListener("click", () => {
			dialog.close();
		});

		dialog.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") {
				event.preventDefault();
				scrollToImage(getCurrentIndex() - 1, "auto");
			} else if (event.key === "ArrowRight") {
				event.preventDefault();
				scrollToImage(getCurrentIndex() + 1, "auto");
			}
		});

		// The dialog fills the screen, so a click outside the image and the controls hit empty space.
		dialog.addEventListener("click", (event) => {
			if (
				event.target instanceof Element &&
				!event.target.closest("img, button, figcaption")
			) {
				dialog.close();
			}
		});
	}
</script>
