---
import type { CollectionEntry } from "astro:content";
import { getDictionary, type Locale } from "../../i18n";
import { siteDetails } from "../../lib/site";
import ProjectCard from "../cards/ProjectCard.astro";
import Section from "../Section.astro";

interface Props {
	projects: CollectionEntry<"projects">[];
	locale: Locale;
}

const { projects, locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<Section id="projects" title={dictionary.projects.title}>
	<div class="grid gap-6 md:grid-cols-2">
		{projects.map((project) => (
			<ProjectCard project={project} locale={locale} />
		))}
	</div>
	<p class="mt-8">
		{dictionary.projects.moreProjects}{" "}
		<a
			href={siteDetails.github}
			target="_blank"
			rel="noopener"
			class="font-semibold text-accent link-underline"
		>
			{dictionary.projects.moreProjectsLink}
		</a>
		.
	</p>
</Section>
