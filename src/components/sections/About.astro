---
import { Image } from "astro:assets";
import { getDictionary, type Locale } from "../../i18n";
import portrait from "../../assets/about/portrait.jpg";
import Section from "../Section.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<Section id="about" title={dictionary.about.title}>
	<div class="grid items-start gap-8 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-12">
		<Image
			src={portrait}
			alt={dictionary.about.photoAlt}
			widths={[320, 640]}
			sizes="(min-width: 768px) 20rem, 100vw"
			class="aspect-square w-full max-w-80 object-cover"
		/>
		<div class="max-w-[60ch] space-y-4 text-lg">
			{dictionary.about.text.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</div>
	</div>
</Section>
