---
import { getDictionary, type Locale } from "../../i18n";
import ProcessStepIcon, {
	type ProcessStepIconName,
} from "../icons/ProcessStepIcon.astro";
import Section from "../Section.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);

// In the order of dictionary.process.steps.
const stepIcons: ProcessStepIconName[] = [
	"consultation",
	"proposal",
	"materials",
	"development",
	"launch",
	"support",
];
---

<Section id="collaboration" title={dictionary.process.title}>
	<!-- A vertical timeline: down the left edge on phones, through the middle from md with the
	     steps alternating sides. The line fills with the accent up to the middle of the viewport
	     as the page scrolls (script below). Every step is rendered as reached, so without
	     JavaScript or with reduced motion the timeline is simply fully coloured. -->
	<div data-process-timeline class="relative">
		<div aria-hidden="true" class="timeline-track bg-line">
			<div class="timeline-fill bg-accent"></div>
		</div>
		{/* auto-rows-fr gives every step the height of the tallest one, so the icons sit at
		     equal distances whatever the length of each text. */}
		<ol class="relative grid auto-rows-fr gap-6 md:gap-y-8">
			{dictionary.process.steps.map((step, index) => (
				<li
					data-timeline-step
					data-reached
					class="group grid grid-cols-[2.5rem_1fr] gap-x-5 md:grid-cols-[1fr_3rem_1fr] md:gap-x-0"
				>
					<div
						data-timeline-node
						class="relative z-10 col-start-1 row-start-1 grid size-10 place-items-center rounded-full border border-line bg-background text-xl text-muted ring-4 ring-background transition-colors duration-300 group-data-reached:border-accent group-data-reached:text-accent md:col-start-2 md:size-12 md:text-2xl"
					>
						<ProcessStepIcon name={stepIcons[index]} />
					</div>
					<div
						data-reveal
						class="relative col-start-2 row-start-1 md:col-start-1 md:pr-14 md:group-even:col-start-3 md:group-even:pr-0 md:group-even:pl-14"
					>
						{/* Joins the icon to the card across the gap; top matches the icon centre. */}
						<span
							aria-hidden="true"
							class="absolute top-5 -left-5 h-px w-5 bg-line transition-colors duration-300 group-data-reached:bg-accent md:top-6 md:right-0 md:left-auto md:w-14 md:group-even:right-auto md:group-even:left-0"
						/>
						<article class="h-full border border-line bg-surface p-5 md:p-6">
							<div class="flex items-baseline gap-3">
								<span
									aria-hidden="true"
									class="text-sm font-semibold text-muted transition-colors duration-300 font-stretch-expanded group-data-reached:text-accent"
								>
									{String(index + 1).padStart(2, "0")}
								</span>
								<h3 class="text-lg">{step.title}</h3>
							</div>
							<p class="mt-2 text-muted">{step.description}</p>
						</article>
					</div>
				</li>
			))}
		</ol>
	</div>
</Section>

<style>
	/* The script measures the centres of the first and last icon and stores them here; the
	   fallbacks run the line from the first icon to the bottom of the list. */
	.timeline-track {
		position: absolute;
		left: 1.25rem;
		top: var(--timeline-start, 1.25rem);
		height: var(--timeline-length, calc(100% - 1.25rem));
		/* Two pixels so the centred line lands on whole pixels instead of blurring across two. */
		width: 2px;
		translate: -50% 0;
		overflow: hidden;

		@media (width >= 48rem) {
			left: 50%;
		}
	}

	.timeline-fill {
		height: 100%;
		transform-origin: top;
		scale: 1 var(--timeline-progress, 1);
	}
</style>

<script>
	// Fills the timeline up to the middle of the viewport and marks the steps whose icon the
	// fill has passed. Scrolling back up empties it again.
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

	function verticalCenter(element: Element): number {
		const { top, height } = element.getBoundingClientRect();
		return top + height / 2;
	}

	function update(timeline: HTMLElement): void {
		const steps = [
			...timeline.querySelectorAll<HTMLElement>("[data-timeline-step]"),
		];
		const nodeCenters = steps.map((step) =>
			verticalCenter(step.querySelector("[data-timeline-node]")!),
		);
		const start = nodeCenters[0];
		const length = nodeCenters[nodeCenters.length - 1] - start;
		const timelineTop = timeline.getBoundingClientRect().top;

		timeline.style.setProperty(
			"--timeline-start",
			`${start - timelineTop}px`,
		);
		timeline.style.setProperty("--timeline-length", `${length}px`);

		const fillEnd = reducedMotion.matches
			? Infinity
			: window.innerHeight / 2;
		const progress = Math.min(Math.max((fillEnd - start) / length, 0), 1);

		timeline.style.setProperty("--timeline-progress", String(progress));
		steps.forEach((step, index) =>
			step.toggleAttribute("data-reached", nodeCenters[index] <= fillEnd),
		);
	}

	for (const timeline of document.querySelectorAll<HTMLElement>(
		"[data-process-timeline]",
	)) {
		let frameRequested = false;

		const scheduleUpdate = (): void => {
			if (frameRequested) return;
			frameRequested = true;
			requestAnimationFrame(() => {
				frameRequested = false;
				update(timeline);
			});
		};

		window.addEventListener("scroll", scheduleUpdate, { passive: true });
		window.addEventListener("resize", scheduleUpdate);
		reducedMotion.addEventListener("change", scheduleUpdate);
		update(timeline);
	}
</script>
