---
import { getDictionary, type Locale } from "../../i18n";
import Section from "../Section.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<Section id="collaboration" title={dictionary.process.title}>
	<!-- The numbers sit on one timeline: a line runs from each number to the next one –
	     down the left edge on phones, across the row from md. The last step has no line. -->
	<ol class="grid gap-8 md:grid-cols-5 md:gap-6">
		{dictionary.process.steps.map((step, index) => (
			<li class="group grid grid-cols-[2rem_1fr] gap-x-4 md:block">
				<div class="flex flex-col items-center pt-1.5 md:flex-row md:gap-3 md:pt-0">
					<span
						aria-hidden="true"
						class="text-sm font-semibold text-accent font-stretch-expanded"
					>
						{String(index + 1).padStart(2, "0")}
					</span>
					<span
						aria-hidden="true"
						class="mt-3 -mb-8 w-px flex-1 bg-line group-last:hidden md:mt-0 md:mb-0 md:-mr-3 md:h-px md:w-auto"
					></span>
				</div>
				<div>
					<h3 class="text-lg md:mt-4">{step.title}</h3>
					<p class="mt-2 text-muted">{step.description}</p>
				</div>
			</li>
		))}
	</ol>
</Section>
