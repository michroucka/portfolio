---
import { getDictionary, type Locale } from "../../i18n";
import Section from "../Section.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<Section id="collaboration" title={dictionary.process.title}>
	<!-- The numbers sit on one timeline: a line runs from each number to the next one –
	     down the left edge on phones, across the row from md, in two rows of three steps
	     (six in one row leaves too little width for the texts). A row's last line fades out
	     and the next row starts with a short fade-in inside the page gutter, so the timeline
	     reads as continuing. The three per row lives in three places that must agree:
	     md:grid-cols-3 and the md:group-nth-[3n] / [3n+4] variants below. The last step
	     has no line. -->
	<ol class="grid gap-8 md:grid-cols-3 md:gap-x-6 md:gap-y-12">
		{dictionary.process.steps.map((step, index) => (
			<li class="group grid grid-cols-[2rem_1fr] gap-x-4 md:block">
				<div class="flex flex-col items-center pt-1.5 md:flex-row md:gap-3 md:pt-0">
					{/* Stays inside the 1.5rem page gutter; the negative margins cancel its width and
					     the flex gap, so the number keeps its place at the column start. */}
					<span
						aria-hidden="true"
						class="hidden h-px w-[1.125rem] -ml-6 -mr-1.5 bg-line [mask-image:linear-gradient(to_right,transparent,black_60%)] md:group-nth-[3n+4]:block"
					></span>
					<span
						aria-hidden="true"
						class="text-sm font-semibold text-accent font-stretch-expanded"
					>
						{String(index + 1).padStart(2, "0")}
					</span>
					<span
						aria-hidden="true"
						class="mt-3 -mb-8 w-px flex-1 bg-line group-last:hidden md:mt-0 md:mb-0 md:-mr-3 md:h-px md:w-auto md:group-nth-[3n]:mr-0 md:group-nth-[3n]:[mask-image:linear-gradient(to_right,black_70%,transparent)]"
					></span>
				</div>
				<div>
					<h3 class="text-lg md:mt-4">{step.title}</h3>
					<p class="mt-2 text-muted">{step.description}</p>
				</div>
			</li>
		))}
	</ol>
</Section>
