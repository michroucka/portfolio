---
import { getDictionary, type Locale } from "../../i18n";
import { getPath } from "../../i18n/routes";
import type { Section } from "../../lib/sections";
import { splitLastWord } from "../../lib/text";
import BrandDot from "../BrandDot.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const titleParts = splitLastWord(dictionary.hero.title);
const homePath = getPath("home", locale);
const sectionHref = (section: Section) => `${homePath}#${section}`;
---

<section class="py-16 md:py-28">
	<h1 class="max-w-[16ch] text-4xl md:text-5xl">
		{titleParts.lead} <BrandDot>{titleParts.lastWord}</BrandDot>
	</h1>
	<p class="mt-6 max-w-[42ch] text-lg text-muted">
		{dictionary.hero.subtitle}
	</p>
	<div class="mt-10 flex flex-wrap gap-4">
		<a href={sectionHref("contact")} class="button-primary">
			{dictionary.hero.primaryCta}
		</a>
		<a href={sectionHref("projects")} class="button-secondary">
			{dictionary.hero.secondaryCta}
		</a>
	</div>
</section>
