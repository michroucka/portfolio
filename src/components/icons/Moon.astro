---
// Phosphor Icons – "moon" (regular) and "moon-stars" (fill), MIT License, https://phosphoricons.com
// Dekorativní ikona: přístupné jméno musí nést rodičovský prvek.
interface Props {
	class?: string;
	size?: string;
	fillOnHover?: boolean;
}

const { class: className, size = "1em", fillOnHover = false } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 256 256"
	width={size}
	height={size}
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
	class={className}
>
	{fillOnHover ? (
		<>
			<!-- moon stroke: měsíc z moon-stars (regular) bez hvězdiček, aby seděl s výplní -->
			<path
				d="M216.77,153a8,8,0,0,1,1.43,8A96,96,0,1,1,95.07,37.8a8,8,0,0,1,10.6,9.06A88.07,88.07,0,0,0,209.14,150.33,8,8,0,0,1,216.77,153Zm-19.39,14.88c-1.79.09-3.59.14-5.38.14A104.11,104.11,0,0,1,88,64c0-1.79,0-3.59.14-5.38A80,80,0,1,0,197.38,167.86Z"
				class="opacity-100 group-focus-visible:opacity-0 group-hover:opacity-0 motion-safe:transition-opacity"
			></path>
			<!-- moon-stars fill -->
			<path
				d="M240,96a8,8,0,0,1-8,8H216v16a8,8,0,0,1-16,0V104H184a8,8,0,0,1,0-16h16V72a8,8,0,0,1,16,0V88h16A8,8,0,0,1,240,96ZM144,56h8v8a8,8,0,0,0,16,0V56h8a8,8,0,0,0,0-16h-8V32a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16Zm65.14,94.33A88.07,88.07,0,0,1,105.67,46.86a8,8,0,0,0-10.6-9.06A96,96,0,1,0,218.2,160.93a8,8,0,0,0-9.06-10.6Z"
				class="opacity-0 group-focus-visible:opacity-100 group-hover:opacity-100 motion-safe:transition-opacity"
			></path>
		</>
	) : (
		// moon stroke
		<path d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"></path>
	)}
