---
// Vlastní ikona menu: dvě hranaté čáry, spodní kratší a zarovnaná doprava
// (sedí k Archivu v řezu bold a připomíná kurzor „_“ z animace loga).
// Dekorativní ikona: přístupné jméno musí nést rodičovský prvek.
// S morphOnDialogOpen se uvnitř otevřeného <dialog> čáry složí do křížku.
interface Props {
	class?: string;
	size?: string;
	morphOnDialogOpen?: boolean;
}

const {
	class: className,
	size = "1em",
	morphOnDialogOpen = false,
} = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 256 256"
	width={size}
	height={size}
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
	class={className}
	data-morph={morphOnDialogOpen || undefined}
>
	<!-- 224 × 32 (16–240) a 144 × 32 (96–240), středy na y 80 a 176 -->
	<rect x="16" y="64" width="224" height="32" data-line="top"></rect>
	<rect x="96" y="160" width="144" height="32" data-line="bottom"></rect>
</svg>

<style>
	svg[data-morph] rect[data-line] {
		transform-box: fill-box;
		transform-origin: center;
	}

	/* Křížek: obě čáry se posunou do středu ikony (128, 128), otočí o ±45°
	   a mají délku 238 – kompromis mezi délkou horní čáry (224) a šířkou ikony. */
	:global(dialog[open]) svg[data-morph] rect[data-line="top"] {
		transform: translateY(48px) rotate(45deg) scaleX(1.0625);
	}
	/* Spodní má střed v (168, 176) → posun (-40, -48); délka 144 → 238 = scaleX(1.653). */
	:global(dialog[open]) svg[data-morph] rect[data-line="bottom"] {
		transform: translate(-40px, -48px) rotate(-45deg) scaleX(1.653);
	}

	@media (prefers-reduced-motion: no-preference) {
		svg[data-morph] rect[data-line] {
			transition-property: transform;
			transition-timing-function: var(
				--default-transition-timing-function
			);
			transition-duration: var(--default-transition-duration);
		}
	}
	@starting-style {
		:global(dialog[open]) svg[data-morph] rect[data-line] {
			transform: none;
		}
	}
</style>
