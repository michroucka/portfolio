---
// Custom menu icon: two square-ended bars, the lower one shorter and right-aligned
// (matches bold Archivo and echoes the "_" cursor of the logo animation).
// Decorative: the parent must provide the accessible name.
// With morphOnDialogOpen the bars fold into a close icon inside an open <dialog>.
interface Props {
	class?: string;
	size?: string;
	morphOnDialogOpen?: boolean;
}

const {
	class: className,
	size = "1em",
	morphOnDialogOpen = false,
} = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 256 256"
	width={size}
	height={size}
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
	class={className}
	data-morph={morphOnDialogOpen || undefined}
>
	<!-- 224 × 32 (16–240) and 144 × 32 (96–240), centred at y 80 and 176 -->
	<rect x="16" y="64" width="224" height="32" data-line="top"></rect>
	<rect x="96" y="160" width="144" height="32" data-line="bottom"></rect>
</svg>

<style>
	svg[data-morph] rect[data-line] {
		transform-box: fill-box;
		transform-origin: center;
	}

	/* Close icon: both bars move to the icon centre (128, 128), rotate by ±45° and become
	   238 long – a compromise between the top bar (224) and the icon width. */
	:global(dialog[open]) svg[data-morph] rect[data-line="top"] {
		transform: translateY(48px) rotate(45deg) scaleX(1.0625);
	}
	/* The lower bar is centred at (168, 176) → translate (-40, -48); length 144 → 238 = scaleX(1.653). */
	:global(dialog[open]) svg[data-morph] rect[data-line="bottom"] {
		transform: translate(-40px, -48px) rotate(-45deg) scaleX(1.653);
	}

	@media (prefers-reduced-motion: no-preference) {
		svg[data-morph] rect[data-line] {
			transition-property: transform;
			transition-timing-function: var(
				--default-transition-timing-function
			);
			transition-duration: var(--default-transition-duration);
		}
	}
	@starting-style {
		:global(dialog[open]) svg[data-morph] rect[data-line] {
			transform: none;
		}
	}
</style>
