---
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";
interface Props {
	// Přístupný popisek tlačítka. Zatím ho předává rodič, po Úkolu 3 přijde ze slovníku.
	label: string;
	size?: string;
}

const { label, size } = Astro.props;
---

<!-- *: = přímí potomci (obě ikony): stejná buňka gridu (překryv) a společný přechod.
     Na ikonách zůstávají jen jejich stavy pro tmavé/světlé téma. -->
<button
	type="button"
	class="group grid cursor-pointer *:col-start-1 *:row-start-1 motion-safe:*:transition-[opacity,rotate,scale]"
	data-theme-toggle
	aria-label={label}
>
	<Sun
		class="opacity-0 rotate-45 scale-90 light:opacity-100 light:rotate-0 light:scale-100"
		size={size}
		fillOnHover
	/>
	<Moon
		class="opacity-100 rotate-0 scale-100 light:opacity-0 light:-rotate-45 light:scale-90"
		size={size}
		fillOnHover
	/>
</button>

<script>
	import {
		isTheme,
		resolveTheme,
		systemLightQuery,
		themeKey,
		toggleTheme,
		type Theme,
	} from "../lib/theme";

	function readCurrentTheme(): Theme {
		const attr = document.documentElement.getAttribute("data-theme");

		return isTheme(attr) ? attr : "dark";
	}

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		const toggles = document.querySelectorAll("[data-theme-toggle]");

		for (const toggle of toggles) {
			toggle.setAttribute(
				"aria-pressed",
				theme === "light" ? "true" : "false",
			);
		}
	}

	function readStoredTheme(): string | null {
		try {
			return localStorage.getItem(themeKey);
		} catch {
			return null;
		}
	}

	function saveTheme(theme: Theme): void {
		try {
			localStorage.setItem(themeKey, theme);
		} catch {
			// selhání nesmí rozbít přepnutí
		}
	}

	const toggles = document.querySelectorAll("[data-theme-toggle]");
	applyTheme(readCurrentTheme());
	for (const toggle of toggles) {
		toggle.addEventListener("click", () => {
			const newTheme = toggleTheme(readCurrentTheme());
			applyTheme(newTheme);
			saveTheme(newTheme);
		});
	}

	// Změna systémového tématu za běhu (např. automatické přepínání podle denní doby).
	// Uložená ruční volba má přednost – resolveTheme ji vrátí a systém se ignoruje.
	window.matchMedia(systemLightQuery).addEventListener("change", (event) => {
		applyTheme(
			resolveTheme({
				stored: readStoredTheme(),
				system: event.matches ? "light" : "dark",
			}),
		);
	});
</script>
