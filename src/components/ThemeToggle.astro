---
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";
interface Props {
	label: string;
	size?: string;
	class?: string;
}

const { label, size = "1.75em", class: className } = Astro.props;
---

<!-- *: targets both icons: same grid cell (stacked) and a shared transition.
     The icons themselves only carry their dark/light theme states. -->
<button
	type="button"
	class:list={[
		className,
		"group grid cursor-pointer *:col-start-1 *:row-start-1 motion-safe:*:transition-[opacity,rotate,scale]",
	]}
	data-theme-toggle
	aria-label={label}
>
	<Sun
		class="opacity-0 rotate-45 scale-90 light:opacity-100 light:rotate-0 light:scale-100"
		size={size}
		fillOnHover
	/>
	<Moon
		class="opacity-100 rotate-0 scale-100 light:opacity-0 light:-rotate-45 light:scale-90"
		size={size}
		fillOnHover
	/>
</button>

<script>
	import {
		isTheme,
		resolveTheme,
		systemLightQuery,
		themeColors,
		themeColorSelector,
		themeKey,
		toggleTheme,
		type Theme,
	} from "../lib/theme";

	function readCurrentTheme(): Theme {
		const attr = document.documentElement.getAttribute("data-theme");

		return isTheme(attr) ? attr : "dark";
	}

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		document
			.querySelector(themeColorSelector)
			?.setAttribute("content", themeColors[theme]);
		const toggles = document.querySelectorAll("[data-theme-toggle]");

		for (const toggle of toggles) {
			toggle.setAttribute(
				"aria-pressed",
				theme === "light" ? "true" : "false",
			);
		}
	}

	function readStoredTheme(): string | null {
		try {
			return localStorage.getItem(themeKey);
		} catch {
			return null;
		}
	}

	function saveTheme(theme: Theme): void {
		try {
			localStorage.setItem(themeKey, theme);
		} catch {
			// A storage failure must not break the toggle.
		}
	}

	const toggles = document.querySelectorAll("[data-theme-toggle]");
	applyTheme(readCurrentTheme());
	for (const toggle of toggles) {
		toggle.addEventListener("click", () => {
			const newTheme = toggleTheme(readCurrentTheme());
			applyTheme(newTheme);
			saveTheme(newTheme);
		});
	}

	// System theme changes at runtime (e.g. automatic day/night switching).
	// A stored manual choice wins – resolveTheme returns it and ignores the system.
	window.matchMedia(systemLightQuery).addEventListener("change", (event) => {
		applyTheme(
			resolveTheme({
				stored: readStoredTheme(),
				system: event.matches ? "light" : "dark",
			}),
		);
	});
</script>
