---
import { getDictionary, type Locale } from "../i18n";
import { type Page, type RouteParams, getPath } from "../i18n/routes";
import Logo from "./Logo.astro";
import { sections } from "../lib/sections";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import { pageContainer } from "../lib/site";

interface Props {
	locale: Locale;
	page?: Page;
	params?: RouteParams;
}

const { locale, page, params } = Astro.props;
const homePath = getPath("home", locale);
const dictionary = getDictionary(locale);
// Shared by the header and the mobile menu's top row – the menu and close buttons must line up exactly.
const headerClasses = `${pageContainer} py-2 md:py-4 flex items-center justify-between`;
const logoClasses = "w-44 md:w-60";
const menuButtonClasses = "block md:hidden p-4 -mr-[calc(1rem+0.16em)]";
const menuIconSize = "1.75em";
---

<header class={headerClasses}>
	<a href={homePath} class="group">
		<Logo class={logoClasses} animateDotOnHover />
	</a>

	<div class="hidden md:flex items-center gap-6">
		<nav
			aria-label={dictionary.header.navigation}
			class="flex gap-6 text-lg font-stretch-expanded font-semibold"
		>
			{sections.map((section) => (
				<a href={`${homePath}#${section}`} class="link-underline">
					{dictionary.nav[section]}
				</a>
			))}
		</nav>

		<!-- The divider belongs to the switcher – without it (e.g. 404) it would dangle at the end of the row -->
		{page && (
			<>
				<span aria-hidden="true" class="h-5 w-px bg-line"></span>
				<LanguageSwitcher
					locale={locale}
					page={page}
					params={params}
					class="-mx-2"
				/>
			</>
		)}
	</div>

	<button
		type="button"
		data-menu-open
		aria-label={dictionary.header.menuOpen}
		class={menuButtonClasses}
	>
		<MenuIcon size={menuIconSize} />
	</button>

	<!-- On close the dialog loses [open] immediately but stays visible for the transition (allow-discrete),
	     so its position and layout must not depend on [open] (fixed inset-0, flex-col always) – only display (open:flex). -->
	<dialog
		data-menu
		aria-label={dictionary.header.menu}
		class="fixed inset-0 open:flex flex-col w-full h-dvh bg-background text-foreground border-0 p-0 m-0 max-w-none max-h-none"
	>
		<div class={headerClasses}>
			<a href={homePath}>
				<Logo class={logoClasses} />
			</a>
			<button
				type="button"
				data-menu-close
				aria-label={dictionary.header.menuClose}
				class={menuButtonClasses}
			>
				<MenuIcon size={menuIconSize} morphOnDialogOpen />
			</button>
		</div>
		<nav
			aria-label={dictionary.header.navigation}
			class:list={[
				"flex flex-col text-2xl font-stretch-expanded font-semibold",
				pageContainer,
			]}
		>
			{sections.map((section, index) => (
				<a
					href={`${homePath}#${section}`}
					style={{ "--index": index }}
					class="flex items-center justify-between py-4"
				>
					{dictionary.nav[section]}
					<span aria-hidden="true" class="text-3xl">
						›
					</span>
				</a>
			))}
		</nav>
		{page && (
			<LanguageSwitcher
				locale={locale}
				page={page}
				params={params}
				class="mt-auto ms-auto pr-3 pb-8"
			/>
		)}
	</dialog>
</header>

<style>
	:global(html:has(dialog[open])) {
		overflow: hidden;
	}

	dialog[data-menu] {
		opacity: 0;
	}

	dialog[data-menu] nav a {
		opacity: 0;
		translate: 0 -1rem;
	}

	dialog[data-menu][open] {
		opacity: 1;
	}

	dialog[data-menu][open] nav a {
		opacity: 1;
		translate: 0;
	}

	@starting-style {
		dialog[data-menu][open] {
			opacity: 0;
		}
		dialog[data-menu][open] nav a {
			opacity: 0;
			translate: 0 -1rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* display + overlay (allow-discrete) keep the dialog visible until the close transition ends */
		dialog[data-menu] {
			transition-property: opacity, display, overlay;
			transition-behavior: allow-discrete;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
		dialog[data-menu] nav a {
			transition-property: opacity, translate;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
		dialog[data-menu][open] nav a {
			transition-delay: calc(var(--index) * 40ms);
		}
	}
</style>

<script>
	const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
	const openButton = document.querySelector("[data-menu-open]");
	const closeButton = document.querySelector("[data-menu-close]");

	if (!menu || !openButton || !closeButton) {
		throw new Error("Menu elements not found");
	}

	const openMenu = (): void => {
		menu.showModal();
	};

	const closeMenu = (): void => {
		menu.close();
	};

	openButton.addEventListener("click", openMenu);
	closeButton.addEventListener("click", closeMenu);

	menu.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) {
			return;
		}

		const link = event.target.closest("a");

		if (link) {
			closeMenu();
		}
	});

	const desktopQuery = window.matchMedia("(min-width: 48rem)"); // Tailwind md breakpoint

	desktopQuery.addEventListener("change", (event) => {
		if (event.matches) {
			closeMenu();
		}
	});
</script>
