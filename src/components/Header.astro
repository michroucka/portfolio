---
import { getDictionary, type Locale } from "../i18n";
import { type Page, type RouteParams, getPath } from "../i18n/routes";
import Logo from "./Logo.astro";
import { getSectionHref, sections } from "../lib/sections";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MenuIcon from "./icons/MenuIcon.astro";
import { pageContainer } from "../lib/site";

interface Props {
	locale: Locale;
	page?: Page;
	params?: RouteParams;
}

const { locale, page, params } = Astro.props;
const homePath = getPath("home", locale);
const dictionary = getDictionary(locale);
// Shared by the header and the mobile menu's top row – the menu and close buttons must line up exactly.
const headerClasses = `${pageContainer} min-h-(--header-height) py-2 lg:py-4 flex items-center justify-between`;
const logoClasses = "w-48 sm:w-56 lg:w-60";
const menuButtonClasses = "block lg:hidden p-4 -mr-[calc(1rem+0.16em)]";
const menuIconSize = "1.75em";
---

<!-- Full-width sticky bar; the content row inside keeps to the page container. -->
<header data-site-header class="sticky top-0 z-40">
	<div data-header-backdrop aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
		<span></span>
	</div>
	<div class={headerClasses}>
		<a href={homePath}>
			<Logo class={logoClasses} />
		</a>

		<div class="hidden lg:flex items-center gap-6">
			<nav
				aria-label={dictionary.header.navigation}
				class="flex gap-5 whitespace-nowrap text-base font-stretch-expanded font-semibold xl:gap-6 xl:text-lg"
			>
				{sections.map((section) => (
					<a
						href={getSectionHref(section, locale)}
						class="link-underline"
					>
						{dictionary.nav[section]}
					</a>
				))}
			</nav>

			<!-- The divider belongs to the switcher – without it (e.g. 404) it would dangle at the end of the row -->
			{page && (
				<>
					<span aria-hidden="true" class="h-5 w-px bg-line"></span>
					<LanguageSwitcher
						locale={locale}
						page={page}
						params={params}
						class="-mx-2"
					/>
				</>
			)}
		</div>

		<button
			type="button"
			data-menu-open
			aria-label={dictionary.header.menuOpen}
			class={menuButtonClasses}
		>
			<MenuIcon size={menuIconSize} />
		</button>
	</div>

	<!-- On close the dialog loses [open] immediately but stays visible for the transition (allow-discrete),
	     so its position and layout must not depend on [open] (fixed inset-0, flex-col always) – only display (open:flex). -->
	<dialog
		data-menu
		aria-label={dictionary.header.menu}
		class="fixed inset-0 open:flex flex-col w-full h-dvh bg-background text-foreground border-0 p-0 m-0 max-w-none max-h-none"
	>
		<div class={headerClasses}>
			<a href={homePath}>
				<Logo class={logoClasses} />
			</a>
			<button
				type="button"
				data-menu-close
				aria-label={dictionary.header.menuClose}
				class={menuButtonClasses}
			>
				<MenuIcon size={menuIconSize} morphOnDialogOpen />
			</button>
		</div>
		<nav
			aria-label={dictionary.header.navigation}
			class:list={[
				"flex flex-col text-2xl font-stretch-expanded font-semibold",
				pageContainer,
			]}
		>
			{sections.map((section, index) => (
				<a
					href={getSectionHref(section, locale)}
					style={{ "--index": index }}
					class="flex items-center justify-between py-4"
				>
					{dictionary.nav[section]}
					<span aria-hidden="true" class="text-3xl">
						›
					</span>
				</a>
			))}
		</nav>
		{page && (
			<LanguageSwitcher
				locale={locale}
				page={page}
				params={params}
				class="mt-auto ms-auto pr-3 pb-8"
			/>
		)}
	</dialog>
</header>

<style>
	/* Progressive blur: the backdrop reaches 4rem below the header and every layer blurs less
	   and fades out further down, so the blur and the tint taper off gradually instead of
	   ending on one edge. It is a separate element because the fading masks would otherwise
	   fade the logo and navigation too. */
	[data-header-backdrop] {
		position: absolute;
		inset: 0 0 -4rem;
		z-index: -1;
		pointer-events: none;
		/* Eased tint: stays dense under the header, then thins out slowly. */
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--theme-background) 85%, transparent) 0%,
			color-mix(in srgb, var(--theme-background) 75%, transparent) 40%,
			color-mix(in srgb, var(--theme-background) 50%, transparent) 55%,
			color-mix(in srgb, var(--theme-background) 26%, transparent) 70%,
			color-mix(in srgb, var(--theme-background) 9%, transparent) 85%,
			transparent 100%
		);
	}

	[data-header-backdrop] span {
		position: absolute;
		inset: 0;
		backdrop-filter: blur(var(--blur));
		mask-image: linear-gradient(
			to bottom,
			black var(--solid),
			transparent var(--end)
		);
	}

	[data-header-backdrop] span:nth-child(1) {
		--blur: 12px;
		--solid: 30%;
		--end: 55%;
	}

	[data-header-backdrop] span:nth-child(2) {
		--blur: 6px;
		--solid: 40%;
		--end: 70%;
	}

	[data-header-backdrop] span:nth-child(3) {
		--blur: 3px;
		--solid: 50%;
		--end: 85%;
	}

	[data-header-backdrop] span:nth-child(4) {
		--blur: 1px;
		--solid: 60%;
		--end: 100%;
	}

	:global(html:has(dialog[open])) {
		overflow: hidden;
	}

	dialog[data-menu] {
		opacity: 0;
	}

	dialog[data-menu] nav a {
		opacity: 0;
		translate: 0 -1rem;
	}

	dialog[data-menu][open] {
		opacity: 1;
	}

	dialog[data-menu][open] nav a {
		opacity: 1;
		translate: 0;
	}

	@starting-style {
		dialog[data-menu][open] {
			opacity: 0;
		}
		dialog[data-menu][open] nav a {
			opacity: 0;
			translate: 0 -1rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* display + overlay (allow-discrete) keep the dialog visible until the close transition ends */
		dialog[data-menu] {
			transition-property: opacity, display, overlay;
			transition-behavior: allow-discrete;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
		dialog[data-menu] nav a {
			transition-property: opacity, translate;
			transition-duration: var(--default-transition-duration);
			transition-timing-function: var(
				--default-transition-timing-function
			);
		}
		dialog[data-menu][open] nav a {
			transition-delay: calc(var(--index) * 40ms);
		}
	}
</style>

<script>
	const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
	const openButton = document.querySelector("[data-menu-open]");
	const closeButton = document.querySelector("[data-menu-close]");

	if (!menu || !openButton || !closeButton) {
		throw new Error("Menu elements not found");
	}

	const openMenu = (): void => {
		menu.showModal();
	};

	const closeMenu = (): void => {
		menu.close();
	};

	openButton.addEventListener("click", openMenu);
	closeButton.addEventListener("click", closeMenu);

	menu.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) {
			return;
		}

		const link = event.target.closest("a");

		if (link) {
			closeMenu();
		}
	});

	const desktopQuery = window.matchMedia("(min-width: 64rem)"); // Tailwind lg breakpoint

	desktopQuery.addEventListener("change", (event) => {
		if (event.matches) {
			closeMenu();
		}
	});
</script>
