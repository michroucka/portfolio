---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getDictionary, type Locale } from "../../i18n";
import { getPath } from "../../i18n/routes";
import { parseProjectId } from "../../lib/projects";

interface Props {
	project: CollectionEntry<"projects">;
	locale: Locale;
}

const { project, locale } = Astro.props;
const dictionary = getDictionary(locale);
const { slug } = parseProjectId(project.id);
const { title, summary, cover, type } = project.data;
// Only the title is a link; its ::after stretches over the card, so the whole card is clickable
// while screen readers announce just the title instead of the whole card text.
---

<article class="relative flex flex-col border border-line bg-surface">
	<Image
		src={cover}
		alt=""
		widths={[400, 800, 1200]}
		sizes="(min-width: 768px) 50vw, 100vw"
		class="aspect-[4/3] w-full border-b border-line object-cover object-top"
	/>
	<div class="flex flex-col p-6">
		<p class="text-sm font-semibold text-muted uppercase">
			{dictionary.projects.types[type]}
		</p>
		<h3 class="mt-2 text-xl">
			<a
				href={getPath("project", locale, { slug })}
				class="link-underline after:absolute after:inset-0"
			>
				{title}
			</a>
		</h3>
		<p class="mt-3 text-muted">{summary}</p>
	</div>
</article>
