---
import type { CollectionEntry } from "astro:content";
import { getDictionary, type Locale } from "../../i18n";
import { formatPrice } from "../../lib/price";

interface Props {
	service: CollectionEntry<"services">;
	locale: Locale;
}

const { service, locale } = Astro.props;
const dictionary = getDictionary(locale);
const { title, description, features, priceFrom } = service.data;
// mt-auto on the price pins it to the bottom, so prices line up across cards of different length.
---

<article class="flex flex-col border border-line bg-surface p-6">
	<h3 class="text-xl">{title[locale]}</h3>
	<p class="mt-3 text-muted">{description[locale]}</p>
	<ul class="mt-6 list-disc space-y-2 ps-5 marker:text-accent">
		{features[locale].map((feature) => (
			<li>{feature}</li>
		))}
	</ul>
	<p class="mt-auto pt-8 text-xl font-semibold font-stretch-expanded">
		<span class="whitespace-nowrap">
			{dictionary.services.priceFrom} {formatPrice(priceFrom, locale)}
		</span>
	</p>
</article>
