---
import logoDarkTheme from "../../brand/logo/mr-horizontal-negative.svg?raw";
import logoLightTheme from "../../brand/logo/mr-horizontal-positive.svg?raw";
import { prepareLogoSvg } from "../lib/logo-svg";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const logoLight = prepareLogoSvg(logoLightTheme);
const logoDark = prepareLogoSvg(logoDarkTheme);
---

<div class={className} role="img" aria-label="Michal Roučka">
	<span set:html={logoLight} class="hidden light:block" />
	<span set:html={logoDark} class="block light:hidden" />
</div>
