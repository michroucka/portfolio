---
import { createHash } from "node:crypto";

import {
	isTheme,
	resolveTheme,
	systemLightQuery,
	themeColors,
	themeColorSelector,
	themeKey,
} from "../lib/theme.ts";

// The inline script must run before the first paint (otherwise the wrong theme flashes),
// so it cannot import modules – the functions from theme.ts are inlined as source text.
// theme.test.ts tests the source functions; scripts/verify-theme-script.mjs checks that the
// built script still runs (e.g. the bundler did not rename isTheme).
// The IIFE keeps isTheme/resolveTheme out of the global scope.
const themeScript = `(() => {
	${isTheme.toString()}
	${resolveTheme.toString()}

	let stored = null;
	try {
		stored = localStorage.getItem(${JSON.stringify(themeKey)});
	} catch {
		// localStorage may be unavailable (private window, blocked storage) – fall back to the system.
	}

	const system = window.matchMedia(${JSON.stringify(systemLightQuery)}).matches
		? "light"
		: "dark";

	const theme = resolveTheme({ stored, system });
	document.documentElement.dataset.theme = theme;

	// Browser UI in the theme colour – the meta tag must come before this script in <head>.
	document
		.querySelector(${JSON.stringify(themeColorSelector)})
		?.setAttribute("content", ${JSON.stringify(themeColors)}[theme]);
})();`;

// Astro hashes only the scripts it processes, so the CSP must be told about this is:inline one.
const themeScriptHash = createHash("sha256")
	.update(themeScript)
	.digest("base64");
Astro.csp.insertScriptHash(`sha256-${themeScriptHash}`);
---

<!-- data-theme-script: lets scripts/verify-theme-script.mjs find this script -->
<script is:inline data-theme-script set:html={themeScript} />
