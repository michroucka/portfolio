---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ProjectPage from "../../components/pages/ProjectPage.astro";
import { getCollection } from "astro:content";
import {
	assertProjectTranslations,
	getProjectsForLocale,
	parseProjectId,
} from "../../lib/projects";

export const getStaticPaths = (async () => {
	const projects = await getCollection("projects");
	assertProjectTranslations(projects);
	const localeProjects = getProjectsForLocale(projects, "cs");

	return localeProjects.map((project) => {
		const { slug } = parseProjectId(project.id);
		return {
			params: { slug },
			props: { project },
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
---

<ProjectPage locale="cs" project={project} />
