---
// 404 nemá logickou stránku v mapě cest ani protějšek v druhém jazyce – Cloudflare ji vrátí
// pro jakoukoli neexistující adresu (českou i /en/…), proto je dvojjazyčná.
// Bez `page` vynechá BaseLayout canonical/hreflang a přepínač jazyka; noindex ji vyřadí z vyhledávání.
import { getDictionary } from "../i18n";
import { getPath } from "../i18n/routes";
import BaseLayout from "../layouts/BaseLayout.astro";

const cs = getDictionary("cs").notFound;
const en = getDictionary("en").notFound;

// Jeden <title> a description pro obě jazykové verze.
const title = `${cs.title} / ${en.title}`;
const description = `${cs.description} ${en.description}`;
---

<BaseLayout locale="cs" title={title} description={description} noindex>
	<section>
		<h1>{cs.title}</h1>
		<p>{cs.description}</p>
		<a href={getPath("home", "cs")} class="link-underline">
			{cs.linkHome}
		</a>
	</section>

	<!-- lang="en": čtečka přečte anglickou část anglicky -->
	<section lang="en">
		<h2>{en.title}</h2>
		<p>{en.description}</p>
		<a href={getPath("home", "en")} class="link-underline">
			{en.linkHome}
		</a>
	</section>
</BaseLayout>
