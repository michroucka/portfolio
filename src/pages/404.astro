---
// The 404 page has no logical page or counterpart in the other language – Cloudflare serves it
// for any missing URL (Czech or /en/…), hence bilingual.
import { getDictionary } from "../i18n";
import { getPath } from "../i18n/routes";
import BaseLayout from "../layouts/BaseLayout.astro";

const cs = getDictionary("cs").notFound;
const en = getDictionary("en").notFound;

const title = `${cs.title} / ${en.title}`;
const description = `${cs.description} ${en.description}`;
---

<BaseLayout locale="cs" title={title} description={description} noindex>
	<section>
		<h1>{cs.title}</h1>
		<p>{cs.description}</p>
		<a href={getPath("home", "cs")} class="link-underline">
			{cs.linkHome}
		</a>
	</section>

	<!-- lang="en" so screen readers pronounce it in English -->
	<section lang="en">
		<h2>{en.title}</h2>
		<p>{en.description}</p>
		<a href={getPath("home", "en")} class="link-underline">
			{en.linkHome}
		</a>
	</section>
</BaseLayout>
