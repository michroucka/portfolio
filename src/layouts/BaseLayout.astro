---
import "../styles/global.css";
import { getDictionary, type Locale } from "../i18n";
import type { Page, RouteParams } from "../i18n/routes";
import ThemeScript from "../components/ThemeScript.astro";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultOgImage, pageContainer } from "../lib/site.ts";

type BaseProps = {
	locale: Locale;
	title: string;
	description: string;
	// Site-relative path; Seo turns it into an absolute URL.
	ogImage?: string;
};

// An indexable page needs its logical page (+ params) for canonical/hreflang and the language
// switcher. Only a noindex page (404) may omit it, so a forgotten `page` is a type error
// instead of a page silently dropped from search results.
type PageProps =
	| { page: Page; params?: RouteParams; noindex?: false }
	| { page?: never; params?: never; noindex: true };

type Props = BaseProps & PageProps;

const {
	locale,
	title,
	description,
	page,
	params,
	ogImage = defaultOgImage,
	noindex,
} = Astro.props;
const dictionary = getDictionary(locale);
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Before ThemeScript, which updates it to the active theme (dark = no-JS default). -->
		<meta name="theme-color" content="#0E0F11" />
		<ThemeScript />
		<Seo
			locale={locale}
			title={title}
			description={description}
			page={page}
			params={params}
			ogImage={ogImage}
			noindex={noindex}
		/>
		<!-- From brand/web/head-snippet.html; the files live in public/ -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<slot name="head" />
	</head>
	<body class="min-h-dvh flex flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:bg-accent focus:text-accent-foreground focus:z-50 focus:text-center focus:p-4"
		>
			{dictionary.layout.skipToMain}
		</a>
		<Header locale={locale} page={page} params={params} />
		<main id="main" class:list={[pageContainer, "flex-1"]}>
			<slot />
		</main>
		<Footer locale={locale} page={page} params={params} />
	</body>
</html>
