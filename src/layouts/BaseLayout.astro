---
import "../styles/global.css";
import { getDictionary, type Locale } from "../i18n";
import type { Page, RouteParams } from "../i18n/routes";
import ThemeScript from "../components/ThemeScript.astro";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getDefaultOgImage, pageContainer } from "../lib/site.ts";

type BaseProps = {
	locale: Locale;
	title: string;
	description: string;
	// Site-relative path; Seo turns it into an absolute URL.
	ogImage?: string;
};

// An indexable page needs its logical page (+ params) for canonical/hreflang and the language
// switcher. Only a noindex page (404) may omit it, so a forgotten `page` is a type error
// instead of a page silently dropped from search results.
type PageProps =
	| { page: Page; params?: RouteParams; noindex?: false }
	| { page?: never; params?: never; noindex: true };

type Props = BaseProps & PageProps;

const {
	locale,
	title,
	description,
	page,
	params,
	ogImage = getDefaultOgImage(locale),
	noindex,
} = Astro.props;
const dictionary = getDictionary(locale);
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Before ThemeScript, which updates it to the active theme (dark = no-JS default). -->
		<meta name="theme-color" content="#0E0F11" />
		<ThemeScript />
		<Seo
			locale={locale}
			title={title}
			description={description}
			page={page}
			params={params}
			ogImage={ogImage}
			noindex={noindex}
		/>
		<!-- From brand/web/head-snippet.html; the files live in public/ -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<slot name="head" />
	</head>
	<body class="min-h-dvh flex flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:bg-accent focus:text-accent-foreground focus:z-50 focus:text-center focus:p-4"
		>
			{dictionary.layout.skipToMain}
		</a>
		<Header locale={locale} page={page} params={params} />
		<main id="main" class:list={[pageContainer, "flex-1"]}>
			<slot />
		</main>
		<Footer locale={locale} page={page} params={params} />
	</body>
</html>

<script>
	// Smooth scrolling (global.css) is switched on only after load: the browser jumps to the
	// #fragment of a page opened from another page around load, and that jump should be instant.
	const enableSmoothScroll = (): void => {
		requestAnimationFrame(() => {
			document.documentElement.dataset.smoothScroll = "";
		});
	};

	if (document.readyState === "complete") enableSmoothScroll();
	else window.addEventListener("load", enableSmoothScroll, { once: true });

	// Elements that enter the viewport together (cards in one grid row) appear one after another;
	// the cap keeps a tall screen or a long jump from leaving the last ones waiting.
	const revealStaggerMs = 80;
	const maxRevealStaggerSteps = 4;
	// Reveal a little after the element's top edge crosses the bottom of the viewport.
	const revealLineRatio = 0.92;

	function reveal(element: HTMLElement, staggerStep = 0): void {
		const delay =
			Math.min(staggerStep, maxRevealStaggerSteps) * revealStaggerMs;
		element.style.setProperty("--reveal-delay", `${delay}ms`);
		element.dataset.revealed = "";
		revealObserver.unobserve(element);
	}

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries
				.filter((entry) => entry.isIntersecting)
				.forEach(({ target }, index) =>
					reveal(target as HTMLElement, index),
				);
		},
		{ rootMargin: `0px 0px -${(1 - revealLineRatio) * 100}% 0px` },
	);

	const revealElements = [
		...document.querySelectorAll<HTMLElement>("[data-reveal]"),
	];
	// What is already on screen (or scrolled past by an anchor jump) has been painted visible
	// before this module ran; hiding it now would make it blink, so it stays as it is.
	for (const element of revealElements) {
		if (
			element.getBoundingClientRect().top <
			window.innerHeight * revealLineRatio
		) {
			element.dataset.revealed = "";
		} else {
			revealObserver.observe(element);
		}
	}
	document.documentElement.dataset.revealReady = "";

	// Tabbing can land on an element the observer never reports (scrolled into the band below
	// the reveal line), so focus reveals it too.
	document.addEventListener("focusin", (event) => {
		if (!(event.target instanceof Element)) return;
		const hidden = event.target.closest<HTMLElement>(
			"[data-reveal]:not([data-revealed])",
		);
		if (hidden) reveal(hidden);
	});
</script>
