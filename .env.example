# Copy to .env for local development. The values below are test values:
# Turnstile always-pass keys (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
# and the Resend test sender, which delivers only to the Resend account's own address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=onboarding@resend.dev
